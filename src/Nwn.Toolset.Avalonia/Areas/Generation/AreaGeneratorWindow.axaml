<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:generator="using:Nwn.Toolset.Avalonia.Areas.Generation"
        xmlns:areaGeneration="using:Nwn.Authoring.Areas.Generation"
        xmlns:preview="using:Nwn.Authoring.Areas.Generation.Preview"
        xmlns:decoration="using:Nwn.Authoring.Areas.Generation.Decoration"
        mc:Ignorable="d"
        d:DesignWidth="1180" d:DesignHeight="800"
        x:Class="Nwn.Toolset.Avalonia.Areas.Generation.AreaGeneratorWindow"
        x:DataType="generator:AreaGeneratorViewModel"
        Width="1180" Height="800"
        MinWidth="920" MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBrush}">

  <Window.Styles>
    <Style Selector="TextBlock.pageTitle">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource InkSecondaryBrush}" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Padding" Value="14" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource RuleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox.validationError">
      <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="TextBox.validationError:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
    </Style>
    <Style Selector="TextBlock.validationError">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.statusError">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Padding="18,12"
            Background="{DynamicResource PanelHeaderBrush}"
            BorderBrush="{DynamicResource RuleBrush}"
            BorderThickness="0,0,0,1">
      <StackPanel>
        <TextBlock Classes="pageTitle" Text="{Binding Labels.PageTitle}" />
        <TextBlock Classes="dim"
                   Text="{Binding Labels.PageSubtitle}" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="400,*" IsEnabled="{Binding !IsBusy}">
      <Border Grid.Column="0" Padding="14"
              Background="{DynamicResource PanelRaisedBrush}"
              BorderBrush="{DynamicResource RuleBrush}"
              BorderThickness="0,0,1,0">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="12">
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Classes="sectionTitle" Text="{Binding Labels.CompositionTitle}" />
                <TextBlock Classes="label" Text="{Binding Labels.Theme}" IsVisible="{Binding HasThemes}" />
                <ComboBox ItemsSource="{Binding Themes}" IsVisible="{Binding HasThemes}"
                          SelectedItem="{Binding SelectedTheme, Mode=TwoWay}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="generator:AreaGeneratorThemeChoice">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Classes="label" Text="{Binding Labels.Tier}" IsVisible="{Binding HasThemes}" />
                <ComboBox x:Name="TierSelector" IsVisible="{Binding HasThemes}"
                          ItemsSource="{Binding Tiers}"
                          SelectedItem="{Binding SelectedTier, Mode=TwoWay}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="generator:AreaGeneratorTierChoice">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Classes="label" Text="{Binding Labels.TilesetProfile}" />
                <ComboBox ItemsSource="{Binding TilesetProfiles}"
                          SelectedItem="{Binding SelectedTilesetProfile, Mode=TwoWay}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="generator:AreaGeneratorTilesetChoice">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Classes="label" Text="{Binding Labels.LayoutProfile}" />
                <ComboBox ItemsSource="{Binding LayoutProfiles}"
                          SelectedItem="{Binding SelectedLayoutProfile, Mode=TwoWay}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="generator:AreaGeneratorLayoutChoice">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Classes="sectionTitle" Text="{Binding Labels.AreaTitle}" />
                <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                      ColumnSpacing="10" RowSpacing="8">
                  <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="{Binding Labels.Width}" />
                  <NumericUpDown x:Name="WidthInput" Grid.Row="0" Grid.Column="1"
                                 Value="{Binding Width, Mode=TwoWay}"
                                 Minimum="{Binding MinimumDimension}" Maximum="32" Increment="1" FormatString="0" />
                  <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="{Binding Labels.Height}" />
                  <NumericUpDown x:Name="HeightInput" Grid.Row="1" Grid.Column="1"
                                 Value="{Binding Height, Mode=TwoWay}"
                                 Minimum="{Binding MinimumDimension}" Maximum="32" Increment="1" FormatString="0" />
                  <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="{Binding Labels.Seed}" />
                  <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <NumericUpDown x:Name="SeedInput"
                                   Value="{Binding Seed, Mode=TwoWay}"
                                   Minimum="0" Maximum="2147482647" Increment="1" FormatString="0"
                                   ShowButtonSpinner="False" />
                    <Button x:Name="RandomizeSeedButton" Grid.Column="1"
                            Content="{Binding Labels.Randomize}"
                            Command="{Binding RandomizeSeedCommand}"
                            ToolTip.Tip="{Binding Labels.RandomizeTip}" />
                  </Grid>
                  <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="{Binding Labels.ResRef}" />
                  <StackPanel Grid.Row="3" Grid.Column="1" Spacing="4">
                    <TextBox x:Name="ResRefInput"
                             Classes.validationError="{Binding HasResRefError}"
                             Text="{Binding ResRef, Mode=TwoWay}"
                             Watermark="{Binding Labels.ResRefWatermark}" />
                    <TextBlock x:Name="ResRefErrorText"
                               Classes="validationError"
                               Text="{Binding ResRefError}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding HasResRefError}" />
                  </StackPanel>
                  <TextBlock Grid.Row="4" Grid.Column="0" Classes="label" Text="{Binding Labels.DisplayName}" />
                  <TextBox x:Name="DisplayNameInput" Grid.Row="4" Grid.Column="1"
                           Text="{Binding DisplayName, Mode=TwoWay}" />
                </Grid>
              </StackPanel>
            </Border>

            <Expander Header="{Binding Labels.AdvancedLayout}" IsExpanded="False">
              <Border Classes="card" Margin="0,6,0,0">
                <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                      ColumnSpacing="10" RowSpacing="7">
                  <TextBlock Grid.Row="0" Classes="label" Text="{Binding Labels.Style}" />
                  <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding LayoutStyles}"
                            SelectedItem="{Binding LayoutStyle, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="areaGeneration:DungeonLayoutStyle">
                        <TextBlock Text="{Binding Converter={StaticResource OptionLabels}}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Grid.Row="1" Classes="label" Text="{Binding Labels.MinimumRooms}" />
                  <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding MinRooms, Mode=TwoWay}" Minimum="2" Maximum="12" Increment="1" />
                  <TextBlock Grid.Row="2" Classes="label" Text="{Binding Labels.MaximumRooms}" />
                  <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding MaxRooms, Mode=TwoWay}" Minimum="2" Maximum="16" Increment="1" />
                  <TextBlock Grid.Row="3" Classes="label" Text="{Binding Labels.MinimumRoomSize}" />
                  <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding MinRoomSize, Mode=TwoWay}"
                                 Minimum="{Binding MinimumRoomSizeBound}" Maximum="{Binding MaximumRoomSizeBound}" Increment="1" />
                  <TextBlock Grid.Row="4" Classes="label" Text="{Binding Labels.MaximumRoomSize}" />
                  <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding MaxRoomSize, Mode=TwoWay}"
                                 Minimum="{Binding MinimumRoomSizeBound}" Maximum="{Binding MaximumRoomSizeBound}" Increment="1" />
                  <TextBlock Grid.Row="5" Classes="label" Text="{Binding Labels.CorridorWidth}" />
                  <NumericUpDown Grid.Row="5" Grid.Column="1" Value="{Binding CorridorWidth, Mode=TwoWay}" Minimum="1" Maximum="3" Increment="1" />
                  <TextBlock Grid.Row="6" Classes="label" Text="{Binding Labels.LoopFactor}" />
                  <NumericUpDown Grid.Row="6" Grid.Column="1" Value="{Binding LoopFactorPercent, Mode=TwoWay}" Minimum="0" Maximum="100" Increment="1" />
                  <TextBlock Grid.Row="7" Classes="label" Text="{Binding Labels.OrganicFill}" />
                  <NumericUpDown Grid.Row="7" Grid.Column="1" Value="{Binding OpenFillPercent, Mode=TwoWay}"
                                 Minimum="{Binding MinimumOpenFillPercent}" Maximum="60" Increment="1" />
                  <TextBlock Grid.Row="8" Classes="label" Text="{Binding Labels.Entrances}" />
                  <NumericUpDown Grid.Row="8" Grid.Column="1" Value="{Binding EntranceCount, Mode=TwoWay}" Minimum="1" Maximum="3" Increment="1" />
                  <TextBlock Grid.Row="9" Classes="label" Text="{Binding Labels.Exits}" />
                  <NumericUpDown Grid.Row="9" Grid.Column="1" Value="{Binding ExitCount, Mode=TwoWay}" Minimum="1" Maximum="3" Increment="1" />
                  <CheckBox Grid.Row="10" Grid.ColumnSpan="2" IsChecked="{Binding DoorTransitions, Mode=TwoWay}" Content="{Binding Labels.DoorTransitions}" />
                  <CheckBox Grid.Row="11" Grid.ColumnSpan="2" IsChecked="{Binding AccentEnabled, Mode=TwoWay}" Content="{Binding Labels.AccentEnabled}" />
                  <TextBlock Grid.Row="12" Classes="label" Text="{Binding Labels.AccentDensity}" />
                  <NumericUpDown x:Name="AccentDensityInput" Grid.Row="12" Grid.Column="1"
                                 Value="{Binding AccentDensityPercent, Mode=TwoWay}"
                                 Minimum="0" Maximum="20" Increment="1" IsEnabled="{Binding AccentEnabled}" />
                  <TextBlock Grid.Row="13" Classes="label" Text="{Binding Labels.FeatureDensity}" />
                  <NumericUpDown Grid.Row="13" Grid.Column="1" Value="{Binding FeatureDensityPercent, Mode=TwoWay}" Minimum="0" Maximum="15" Increment="1" />
                  <TextBlock Grid.Row="14" Classes="label" Text="{Binding Labels.HeightRegions}" />
                  <NumericUpDown Grid.Row="14" Grid.Column="1" Value="{Binding ElevationRegions, Mode=TwoWay}"
                                 Minimum="0" Maximum="{Binding MaximumElevationRegions}" Increment="1" />
                </Grid>
              </Border>
            </Expander>

            <Border Classes="card" IsVisible="{Binding HasThemes}">
              <StackPanel Spacing="8">
                <TextBlock Classes="sectionTitle" Text="{Binding Labels.DecorationsTitle}" />
                <CheckBox x:Name="EnableDecorationsToggle" IsChecked="{Binding EnableDecorations, Mode=TwoWay}" Content="{Binding Labels.PlaceDecorations}" />
                <TextBlock Classes="label" Text="{Binding Labels.Palette}" />
                <ComboBox ItemsSource="{Binding DecorationProfiles}"
                          IsEnabled="{Binding EnableDecorations}"
                          SelectedItem="{Binding SelectedDecorationProfile, Mode=TwoWay}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="generator:AreaGeneratorDecorationChoice">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Classes="label" Text="{Binding Labels.Placement}" />
                <ComboBox x:Name="DecorationPlacementSelector" ItemsSource="{Binding DecorationPlacementStyles}"
                          SelectedItem="{Binding DecorationPlacementStyle, Mode=TwoWay}" IsEnabled="{Binding EnableDecorations}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="decoration:DecorationPlacementStyle">
                      <TextBlock Text="{Binding Converter={StaticResource OptionLabels}}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Classes="dim" TextWrapping="Wrap"
                           Text="{Binding Labels.PlacementHint}" />
                <Grid ColumnDefinitions="170,*" ColumnSpacing="10" IsEnabled="{Binding EnableDecorations}">
                  <TextBlock Classes="label" Text="{Binding Labels.Density}" />
                  <NumericUpDown Grid.Column="1" Value="{Binding DecorationDensityPercent, Mode=TwoWay}" Minimum="0" Maximum="200" Increment="5" />
                </Grid>
                <TextBlock Classes="dim" TextWrapping="Wrap" Text="{Binding Labels.DensityHint}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Grid x:Name="PreviewPane" Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="16">
        <Grid x:Name="PreviewToolbar" Grid.Row="0" ColumnDefinitions="*,Auto"
              RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8" Margin="0,0,0,10">
          <ComboBox x:Name="PreviewModeSelector" Grid.Row="0" Grid.Column="0"
                    Width="150" HorizontalAlignment="Left"
                    ItemsSource="{Binding PreviewModes}"
                    SelectedItem="{Binding PreviewMode, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="preview:AreaPreviewMode">
                <TextBlock Text="{Binding Converter={StaticResource OptionLabels}}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button x:Name="GeneratePreviewButton" Grid.Row="0" Grid.Column="1" Classes="primary"
                  Content="{Binding Labels.RefreshPreview}" Command="{Binding GeneratePreviewCommand}" />
          <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal">
            <CheckBox x:Name="ShowRoomsToggle" VerticalAlignment="Center" Margin="0,0,10,4"
                      Content="{Binding Labels.ShowRooms}" IsChecked="{Binding ShowRooms, Mode=TwoWay}" />
            <CheckBox x:Name="ShowTransitionsToggle" VerticalAlignment="Center" Margin="0,0,10,4"
                      Content="{Binding Labels.ShowTransitions}" IsChecked="{Binding ShowTransitions, Mode=TwoWay}" />
            <CheckBox x:Name="ShowDecorationsToggle" VerticalAlignment="Center" Margin="0,0,10,4"
                      Content="{Binding Labels.ShowFootprints}" IsChecked="{Binding ShowDecorations, Mode=TwoWay}"
                      ToolTip.Tip="{Binding Labels.ShowFootprintsTip}" />
            <CheckBox x:Name="ShowRoutesToggle" VerticalAlignment="Center" Content="{Binding Labels.ShowRoutes}" Margin="0,0,10,4"
                      IsChecked="{Binding ShowRoutes, Mode=TwoWay}"
                      ToolTip.Tip="{Binding Labels.ShowRoutesTip}" />
          </WrapPanel>
        </Grid>
        <Border Grid.Row="1" Background="#15181B" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="1" CornerRadius="4">
          <Grid>
            <Image Source="{Binding Preview}" Stretch="Uniform" Margin="12" />
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource InkTertiaryBrush}"
                       Text="{Binding Labels.PreviewPlaceholder}"
                       IsVisible="{Binding Preview, Converter={x:Static ObjectConverters.IsNull}}" />
          </Grid>
        </Border>
        <TextBlock x:Name="StatusMessageText" Grid.Row="2" Margin="2,10,2,0"
                   Classes.dim="{Binding !StatusIsError}"
                   Classes.statusError="{Binding StatusIsError}"
                   TextWrapping="Wrap" Text="{Binding StatusMessage}" />
      </Grid>
    </Grid>

    <Border Grid.Row="2" Padding="14,10" Background="{DynamicResource PanelHeaderBrush}"
            BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <StackPanel x:Name="GenerationProgressPanel" Grid.Column="0" Margin="0,0,20,0"
                    VerticalAlignment="Center" Spacing="5" IsVisible="{Binding IsBusy}">
          <TextBlock x:Name="GenerationProgressText" Text="{Binding BusyMessage}"
                     FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <ProgressBar x:Name="GenerationProgressBar" Height="4" IsIndeterminate="True" />
        </StackPanel>
        <Button Grid.Column="1" Content="{Binding Labels.Close}" Click="OnCloseClicked" IsEnabled="{Binding !IsBusy}" />
        <Button Grid.Column="2" Classes="primary" Content="{Binding Labels.CreateArea}" Command="{Binding CreateAreaCommand}" />
      </Grid>
    </Border>
  </Grid>
</Window>

