<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sounds="using:Nwn.Toolset.Avalonia.Sounds"
             xmlns:variables="using:Nwn.Toolset.Avalonia.Variables"
             xmlns:sharedBehaviors="using:Nwn.Toolset.Avalonia.Behaviors"
             x:Class="Nwn.Toolset.Avalonia.Sounds.Views.SoundBehaviorEditorView"
             x:CompileBindings="True"
             x:DataType="sounds:SoundBehaviorEditorViewModel">

  <UserControl.DataTemplates>
    <!-- The shared property row and extracted native ordered Sounds list. -->
    <DataTemplate DataType="sounds:SoundRowViewModel">
      <StackPanel Margin="16,1">
        <sharedBehaviors:BehaviorRowView />

        <!-- The playlist shares the label-and-value columns used by the other behavior fields. -->
        <sharedBehaviors:LabeledFieldPanel IsVisible="{Binding IsSoundList}">
          <Panel />
          <sounds:SoundListEditorView DataContext="{Binding SoundList}" />
        </sharedBehaviors:LabeledFieldPanel>
      </StackPanel>
    </DataTemplate>
  </UserControl.DataTemplates>

  <DockPanel>
    <sharedBehaviors:BehaviorEditorHeader DockPanel.Dock="Top"
                                          BehaviorName="{Binding HeaderName}"
                                          Kind="{Binding HeaderKind}"
                                          Owner="{Binding HeaderOwner}"
                                          DirtyLabel="{Binding Texts.Unsaved}" />

    <StackPanel DockPanel.Dock="Bottom" Margin="16,6,16,10" Spacing="3">
      <TextBlock Text="{Binding BehaviorChangeNotice}" Foreground="{DynamicResource AmberBrush}"
                 TextWrapping="Wrap"
                 IsVisible="{Binding BehaviorChangeNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Text="{Binding Incomplete}" Foreground="{DynamicResource AmberBrush}"
                 TextWrapping="Wrap" IsVisible="{Binding IsIncomplete}" />
    </StackPanel>

    <TabControl>
      <TabItem Header="{Binding Texts.TabBasic}">
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding BasicRows}" Margin="14,10" />
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{Binding Texts.TabBehavior}">
        <Grid ColumnDefinitions="210,*">
          <sharedBehaviors:BehaviorRailView Grid.Column="0" Items="{Binding BehaviorList}"
                                            ChooseCommand="{Binding ChooseBehaviorCommand}" />

          <ScrollViewer Grid.Column="1" BorderBrush="{DynamicResource RuleBrush}"
                        BorderThickness="1,0,0,0">
            <Border Classes="card" Margin="14,12">
              <StackPanel>
                <TextBlock Text="{Binding HeaderName}" Classes="section" Margin="16,12,16,4" />
                <ItemsControl ItemsSource="{Binding BehaviorRows}" Margin="14,2,14,8" />
              </StackPanel>
            </Border>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <TabItem Header="{Binding Texts.TabVariables}" IsVisible="{Binding ShowsVariablesTab}">
        <variables:VarTableSectionView DataContext="{Binding Variables}" />
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
