<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sounds="using:Nwn.Toolset.Avalonia.Sounds"
             x:Class="Nwn.Toolset.Avalonia.Sounds.SoundListEditorView"
             x:DataType="sounds:SoundListEditorViewModel">
  <StackPanel Spacing="6" HorizontalAlignment="Stretch">
    <TextBlock Text="{Binding NoCatalogLabel}" Classes="label" Foreground="{DynamicResource AmberBrush}"
               IsVisible="{Binding !HasAudioCatalog}" />
    <TextBox Text="{Binding Search, Mode=TwoWay}" Watermark="{Binding SearchWatermark}"
             IsVisible="{Binding HasAudioCatalog}" />
    <TextBlock Text="{Binding SearchSummary}" Classes="count" IsVisible="{Binding HasAudioCatalog}" />
    <ListBox ItemsSource="{Binding FilteredSounds}" IsVisible="{Binding HasAudioCatalog}"
             SelectedItem="{Binding Candidate, Mode=TwoWay}" MaxHeight="170">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="x:String">
          <TextBlock Text="{Binding}" Classes="mono" VerticalAlignment="Center" Margin="4,1" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <Button Content="{Binding AddLabel}" Command="{Binding AddCommand}" HorizontalAlignment="Left"
            IsVisible="{Binding HasAudioCatalog}" />
    <TextBlock Text="{Binding Status}" Classes="label" Foreground="{DynamicResource AmberBrush}"
               TextWrapping="Wrap"
               IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <ListBox Grid.Column="0" ItemsSource="{Binding Rows}"
               SelectedItem="{Binding SelectedEntry, Mode=TwoWay}" MaxHeight="150">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="sounds:SoundListEntryViewModel">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="4,2">
              <TextBlock Grid.Column="0" Text="{Binding Index}" Classes="count" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding ResRef}" Classes="mono" VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Grid.Column="1" Spacing="4" MinWidth="92">
        <Button Content="{Binding PlayLabel}" Command="{Binding PlayCommand}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                IsVisible="{Binding CanPreview}" />
        <Button Content="{Binding StopLabel}" Command="{Binding StopPlaybackCommand}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                IsVisible="{Binding CanPreview}" />
        <Border Height="6" IsVisible="{Binding CanPreview}" />
        <Button Content="{Binding RemoveLabel}" Command="{Binding RemoveCommand}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        <Button Content="{Binding MoveUpLabel}" Command="{Binding MoveUpCommand}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        <Button Content="{Binding MoveDownLabel}" Command="{Binding MoveDownCommand}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
      </StackPanel>
    </Grid>
  </StackPanel>
</UserControl>
