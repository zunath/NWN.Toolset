<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Nwn.Formats</RootNamespace>
    <Description>Native Neverwinter Nights resource formats: GFF, ERF/HAK/MOD, KEY/BIF, 2DA, TLK, MDL (ASCII and binary), MTR and tileset SET files. Pure managed readers and writers with bounded allocation, no engine or UI dependencies.</Description>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../licenses/SWLOR-MIT.txt" Pack="true" PackagePath="licenses/" />
  </ItemGroup>
</Project>
