<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latestMajor</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- One version for the whole package family. Override with -p:Version=... (or
       -p:NwnToolsetVersion=...). Inter-package dependencies resolve to this same version
       because they are ProjectReferences packed from the same build. -->
  <PropertyGroup>
    <NwnToolsetVersion Condition="'$(NwnToolsetVersion)' == ''">0.1.0-preview.1</NwnToolsetVersion>
    <Version Condition="'$(Version)' == ''">$(NwnToolsetVersion)</Version>
  </PropertyGroup>

  <!-- Repository location; a fork overrides it with -p:NwnToolsetRepositoryUrl=... See
       docs/releasing.md. -->
  <PropertyGroup>
    <NwnToolsetRepositoryUrl Condition="'$(NwnToolsetRepositoryUrl)' == ''">https://github.com/zunath/NWN.Toolset</NwnToolsetRepositoryUrl>
  </PropertyGroup>
  <PropertyGroup Condition="'$(NwnToolsetRepositoryUrl)' != ''">
    <RepositoryUrl>$(NwnToolsetRepositoryUrl)</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>$(NwnToolsetRepositoryUrl)</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <!-- NuGet package metadata shared by every packable project. -->
  <PropertyGroup>
    <Authors>Zunath</Authors>
    <Company>Zunath</Company>
    <Copyright>Copyright (c) 2026 Zunath</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>neverwinter-nights;nwn;nwn-toolset;gff;erf;mdl;2da;tlk;modding;game-tools</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup Condition="'$(NwnToolsetPackageFeed)' != ''">
    <RestoreAdditionalProjectSources>$(RestoreAdditionalProjectSources);$(NwnToolsetPackageFeed)</RestoreAdditionalProjectSources>
  </PropertyGroup>
</Project>
